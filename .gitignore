# Replit
.cache/
.local/

# ─────────────────────────────────────────────────────────────
# ENVIRONMENT & SECRETS — NEVER COMMIT THESE
# ─────────────────────────────────────────────────────────────

# Environment variable files (all levels)
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local

# API keys / tokens stored in files
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.csr
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Secret / credential files
secrets/
.secrets/
credentials.json
service-account.json
*-service-account.json
google-credentials.json
firebase-adminsdk*.json
gcloud-service-key.json

# Database
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# Session & auth tokens
.session
*.session
*.token

# Config files that may contain secrets
config/local.js
config/local.json
config/secrets.js
config/secrets.json

# Docker & infrastructure secrets
docker-compose.override.yml
.dockerenv

# AWS
.aws/
aws-exports.js

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
.terraform/

# Logs (may contain sensitive request data)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*
